<?xml version="1.0" ?>
<robot name="rgm2_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="rgm2_urdf" params="prefix:='' attach_to_world:='no'">

<xacro:include filename="$(find rgm2_urdf_description)/urdf/materials.xacro" />
<xacro:include filename="$(find rgm2_urdf_description)/urdf/rgm2_urdf.trans" />
