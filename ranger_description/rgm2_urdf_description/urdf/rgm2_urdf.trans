<?xml version="1.0" ?>
<robot name="rgm2_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="steer_fr_rt_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="steer_fr_rt">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="steer_fr_rt_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

